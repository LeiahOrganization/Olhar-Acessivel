# ============================================================
# Olhar Acessivel - Descricao Automatica de Imagens do Ambiente
# Escolar. Copie este arquivo para  backend/.env  e ajuste.
# ============================================================

# --- Modelo de Visao e Linguagem (endpoint compativel com OpenAI) ---
# Opcao A - Groq (gratuito, chave em console.groq.com/keys):
#   VLM_BASE_URL=https://api.groq.com/openai/v1
#   VLM_MODEL=qwen/qwen3.6-27b
# Opcao B - Google AI Studio (gratuito, chave em aistudio.google.com):
#   VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   VLM_MODEL=gemini-2.0-flash
# Opcao C - modelo local (Ollama com llava/qwen2.5vl, ou vLLM exposto por ngrok):
#   VLM_BASE_URL=http://localhost:11434/v1
#   VLM_MODEL=llava:7b
VLM_BASE_URL=https://api.groq.com/openai/v1
VLM_MODEL=qwen/qwen3.6-27b
VLM_API_KEY=coloque-sua-chave-aqui
VLM_TEMPERATURE=0.3
VLM_MAX_TOKENS=700
VLM_TIMEOUT=90
# "none" desliga o raciocinio explicito (mais rapido); use "default" para compara-lo
VLM_REASONING_EFFORT=none

# --- Pre-processamento da foto do celular ---
# Reduz o consumo de tokens e o tempo de envio em rede movel
IMAGEM_MAX_LADO=1024
IMAGEM_QUALIDADE=82

# --- Sintese de voz (Etapa 3) ---
TTS_ENGINE=edge            # edge | gtts | nenhum
TTS_VOZ=pt-BR-AntonioNeural
TTS_VELOCIDADE=+0%
TTS_CACHE=true

# --- Caminhos ---
IMAGENS_DIR=data/imagens
AUDIO_DIR=data/audio
LOGS_DIR=data/logs

# --- API ---
CORS_ORIGINS=*
ADMIN_TOKEN=troque-este-token
MAX_UPLOAD_MB=12
